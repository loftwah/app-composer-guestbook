{
  "contract": 1,
  "id": "guestbook",
  "name": "Here / there",
  "version": "1.4.0",
  "repository": "https://github.com/loftwah/app-composer-guestbook",
  "runtime": "cloudflare-worker",
  "entry": "src/worker.ts",
  "dataVersion": 1,
  "routes": [
    "/guestbook"
  ],
  "memberService": {
    "version": 1,
    "entrypoint": "GuestbookMemberService",
    "transport": "service-binding",
    "path": "/__composer/member"
  },
  "capabilities": [
    "items:read",
    "items:moderate",
    "media:private"
  ],
  "configuration": {
    "title": {
      "type": "string",
      "default": "Here / there",
      "maxLength": 80
    },
    "intro": {
      "type": "string",
      "default": "A little piece of where you are, approved before it is shared.",
      "maxLength": 240
    },
    "theme": {
      "type": "select",
      "options": [
        "daylight",
        "midnight"
      ],
      "default": "daylight"
    },
    "layout": {
      "type": "select",
      "options": [
        "grid",
        "editorial"
      ],
      "default": "grid"
    },
    "guestAccess": {
      "type": "select",
      "options": [
        "closed",
        "postcards"
      ],
      "default": "closed"
    }
  },
  "portability": {
    "version": 1,
    "format": "guestbook.approved-portable/v1",
    "export": "/api/resources/:resource/portable",
    "restore": "/api/resources/:freshResource/restore",
    "maximumItems": 8,
    "scope": "current-authorized-workspace-account-environment-target",
    "restoredVisibility": "private",
    "requiresLiveSource": true
  },
  "privateEnquiries": {
    "version": 1,
    "model": "briefs/v1",
    "owner": "/api/resources/:resource/enquiries",
    "public": "/r/:resource/c/:configuration/enquiry",
    "default": "closed",
    "retentionDays": 30,
    "receiptDays": 35,
    "notifications": false
  },
  "guestInvitation": {
    "version": 1,
    "kind": "postcard",
    "route": "/r/:resource/api/invitation",
    "states": [
      "open",
      "paused",
      "closed",
      "full"
    ],
    "default": "closed",
    "limits": {
      "message": 160,
      "alias": 60,
      "width": 1200,
      "height": 900,
      "bytes": 100000
    }
  }
}
