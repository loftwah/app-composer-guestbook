{
  "contract": 1,
  "id": "guestbook",
  "name": "Here / there",
  "version": "1.2.0",
  "repository": "https://github.com/loftwah/app-composer-guestbook",
  "runtime": "cloudflare-worker",
  "entry": "src/worker.ts",
  "dataVersion": 1,
  "routes": [
    "/guestbook"
  ],
  "capabilities": [
    "items:read",
    "items:moderate",
    "media:private"
  ],
  "configuration": {
    "title": {
      "type": "string",
      "default": "Here / there",
      "maxLength": 80
    },
    "intro": {
      "type": "string",
      "default": "A little piece of where you are, approved before it is shared.",
      "maxLength": 240
    },
    "theme": {
      "type": "select",
      "options": [
        "daylight",
        "midnight"
      ],
      "default": "daylight"
    },
    "layout": {
      "type": "select",
      "options": [
        "grid",
        "editorial"
      ],
      "default": "grid"
    },
    "guestAccess": {
      "type": "select",
      "options": [
        "closed",
        "postcards"
      ],
      "default": "closed"
    }
  }
}
