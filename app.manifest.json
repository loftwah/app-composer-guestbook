{
  "contract": 1,
  "id": "guestbook",
  "name": "Here / there",
  "version": "1.5.0",
  "repository": "https://github.com/loftwah/app-composer-guestbook",
  "runtime": "cloudflare-worker",
  "entry": "src/worker.ts",
  "dataVersion": 1,
  "routes": [
    "/guestbook"
  ],
  "memberService": {
    "version": 2,
    "entrypoint": "GuestbookMemberService",
    "transport": "service-binding",
    "path": "/__composer/member"
  },
  "capabilities": [
    "items:read",
    "items:moderate",
    "media:private"
  ],
  "agentCapabilities": {
    "version": 1,
    "ui": "https://guestbook.loftwah.com",
    "storage": "app-owned",
    "operations": [
      {
        "name": "read-invitation",
        "description": "Read one visitor book's current invitation state, contribution limits and exact form paths. It never returns the guest code or private media.",
        "kind": "read",
        "method": "GET",
        "path": "/r/:resource/api/invitation",
        "availability": "public",
        "requires": [
          "none"
        ],
        "confirmation": false,
        "verified": "2026-11-06"
      },
      {
        "name": "list-public-items",
        "description": "Read only the currently public, approved contributions. Pending, hidden and deleted items are excluded.",
        "kind": "read",
        "method": "GET",
        "path": "/api/items",
        "availability": "public",
        "requires": [
          "none"
        ],
        "confirmation": false,
        "verified": "2026-11-06"
      },
      {
        "name": "submit-postcard",
        "description": "Submit one short postcard for owner review. Requires the app-issued guest code, explicit consent and a browser-rendered PNG; it cannot publish, moderate or read private records.",
        "kind": "effect",
        "method": "POST",
        "path": "/r/:resource/api/guest-postcard",
        "availability": "guest-invitation",
        "requires": [
          "guest-invitation-code",
          "consent"
        ],
        "confirmation": true,
        "verified": "2026-11-07"
      }
    ]
  },
  "configuration": {
    "title": {
      "type": "string",
      "default": "Here / there",
      "maxLength": 80
    },
    "intro": {
      "type": "string",
      "default": "A little piece of where you are, approved before it is shared.",
      "maxLength": 240
    },
    "theme": {
      "type": "select",
      "options": [
        "daylight",
        "midnight"
      ],
      "default": "daylight"
    },
    "layout": {
      "type": "select",
      "options": [
        "grid",
        "editorial"
      ],
      "default": "grid"
    },
    "guestAccess": {
      "type": "select",
      "options": [
        "closed",
        "postcards",
        "members"
      ],
      "default": "closed"
    }
  },
  "portability": {
    "version": 1,
    "format": "guestbook.approved-portable/v1",
    "export": "/api/resources/:resource/portable",
    "restore": "/api/resources/:freshResource/restore",
    "maximumItems": 8,
    "scope": "current-authorized-workspace-account-environment-target",
    "restoredVisibility": "private",
    "requiresLiveSource": true
  },
  "privateEnquiries": {
    "version": 1,
    "model": "briefs/v1",
    "owner": "/api/resources/:resource/enquiries",
    "public": "/r/:resource/c/:configuration/enquiry",
    "default": "closed",
    "retentionDays": 30,
    "receiptDays": 35,
    "notifications": false
  },
  "guestInvitation": {
    "version": 1,
    "kind": "postcard",
    "route": "/r/:resource/api/invitation",
    "states": [
      "open",
      "paused",
      "closed",
      "full"
    ],
    "default": "closed",
    "limits": {
      "message": 160,
      "alias": 60,
      "width": 1200,
      "height": 900,
      "bytes": 100000
    }
  }
}
