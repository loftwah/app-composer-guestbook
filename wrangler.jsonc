{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "composer-guestbook",
  "account_id": "1003dc1d93af0ebea56b2f1252f89627",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "guestbook.loftwah.com",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "composer-guestbook",
      "database_id": "1b7862f8-35ca-46cc-a37d-e21142f81e21",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://guestbook.loftwah.com",
    "OWNER_STUDIO_URL": "https://composer.loftwah.com/_emdash/admin/plugins/composer-miniapps/apps?app=guestbook",
    "RESOURCE_ACCOUNT_ID": "1003dc1d93af0ebea56b2f1252f89627",
    "RESOURCE_ENVIRONMENT": "production",
    "MEMBER_ISSUER": "https://composer.loftwah.com"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "composer-guestbook-photos"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "preview_urls": false,
  "env": {
    "preview": {
      "workers_dev": false,
      "preview_urls": false,
      "routes": [],
      "vars": {
        "PUBLIC_ORIGIN": "",
        "OWNER_STUDIO_URL": "",
        "RESOURCE_ACCOUNT_ID": "",
        "RESOURCE_ENVIRONMENT": "",
        "MEMBER_ISSUER": ""
      },
      "d1_databases": [],
      "r2_buckets": [],
      "services": [],
      "triggers": {
        "crons": []
      }
    }
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
