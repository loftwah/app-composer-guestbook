  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Existing accent action; light-theme context uses white text.",
      "html": "<button class=\"ds-button\">Send for approval</button>",
      "css": ".ds-button{background:var(--accent,#ff9b55);color:var(--bg,#17181b);font:600 15px/1.55 system-ui,sans-serif;padding:12px 20px;min-height:48px;border:0;border-radius:8px;cursor:pointer}.ds-button:hover{filter:brightness(1.1)}.ds-button:focus-visible{outline:3px solid var(--accent,#ff9b55);outline-offset:4px}:host-context([data-theme=light]) .ds-button{color:white}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Existing quieter theme/owner action.",
      "html": "<button class=\"ds-secondary\">Light mode</button>",
      "css": ".ds-secondary{background:var(--surface,#23252a);color:var(--fg,#f2f3f5);font:600 15px/1.55 system-ui,sans-serif;padding:12px 20px;min-height:48px;border:1px solid var(--control,#797f8a);border-radius:8px;cursor:pointer}.ds-secondary:hover{filter:brightness(1.1)}.ds-secondary:focus-visible{outline:3px solid var(--accent,#ff9b55);outline-offset:4px}"
    },
    {
      "name": "Labelled Input",
      "kind": "input",
      "refersTo": "input",
      "description": "Native body-size field with a visible label.",
      "html": "<label class=\"ds-label\">Name or alias (optional)<input class=\"ds-input\" maxlength=\"60\" value=\"Fictional visitor\"></label>",
      "css": ".ds-label{display:block;color:var(--fg,#f2f3f5);font:16px/1.55 system-ui,sans-serif;margin:12px 0}.ds-input{display:block;width:100%;box-sizing:border-box;margin:6px 0 8px;padding:12px;font:inherit;background:var(--field,#1d1f23);color:var(--fg,#f2f3f5);border:1px solid var(--control,#797f8a);border-radius:6px}.ds-input:focus-visible{outline:3px solid var(--accent,#ff9b55);outline-offset:4px}"
    },
    {
      "name": "Navigation Link",
      "kind": "nav",
      "description": "Ordinary wrapping navigation with current-page accent.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Collection navigation\"><a aria-current=\"page\" href=\"#guestbook\">Guestbook</a><a href=\"#linkarooie\">Linkarooie</a><a href=\"#owner\">Owner studio</a></nav>",
      "css": ".ds-nav{display:flex;gap:8px 20px;flex-wrap:wrap;color:var(--fg,#f2f3f5);font:16px/1.55 system-ui,sans-serif}.ds-nav a{display:inline-flex;align-items:center;min-height:44px;color:inherit;white-space:nowrap;text-underline-offset:4px}.ds-nav a[aria-current]{color:var(--accent,#ff9b55);text-decoration-thickness:2px}.ds-nav a:focus-visible{outline:3px solid var(--accent,#ff9b55);outline-offset:4px}"
    },
    {
      "name": "Demo Artwork Badge",
      "kind": "chip",
      "refersTo": "badge",
      "description": "Existing factual contribution status label, not an interactive chip.",
      "html": "<span class=\"ds-badge\">Demo artwork</span>",
      "css": ".ds-badge{padding:5px 10px;background:var(--surface,#23252a);color:var(--muted,#afb3bb);font:.83rem/1.55 system-ui,sans-serif;border-radius:5px}"
    },
    {
      "name": "Postcard Preview",
      "kind": "custom",
      "refersTo": "postcard-preview",
      "description": "Static SVG specimen of the existing canvas geometry; the application draws canvas and retains accessible text outside the image.",
      "html": "<figure class=\"ds-preview\"><svg class=\"ds-postcard\" viewBox=\"0 0 1200 900\" role=\"img\" aria-label=\"Fictional postcard preview\"><rect width=\"1200\" height=\"900\" fill=\"#f4f0e7\"/><rect x=\"48\" y=\"48\" width=\"1104\" height=\"804\" fill=\"none\" stroke=\"#758174\" stroke-width=\"2\"/><text x=\"92\" y=\"128\" fill=\"#a63d08\" font-family=\"system-ui\" font-size=\"28\" font-weight=\"600\">A postcard for the guestbook</text><text x=\"92\" y=\"250\" fill=\"#20241e\" font-family=\"system-ui\" font-size=\"40\">Hello from a passing visitor.</text><text x=\"92\" y=\"790\" fill=\"#20241e\" font-family=\"system-ui\" font-size=\"28\">From Fictional visitor</text></svg><figcaption>Postcard preview. Your message and alias above are included in the submitted image.</figcaption></figure>",
      "css": ".ds-preview{margin:0}.ds-postcard{display:block;width:100%;height:auto;border-radius:8px}.ds-preview figcaption{font:13px/1.55 system-ui,sans-serif;color:var(--muted,#afb3bb);margin-top:12px}"
    },
    {
      "name": "Contribution Card",
      "kind": "card",
      "description": "Linked postcard specimen with a real caption and alias below the media.",
      "html": "<article class=\"ds-card\"><a href=\"#contribution\"><svg class=\"ds-postcard\" viewBox=\"0 0 1200 900\" role=\"img\" aria-label=\"Fictional postcard preview\"><rect width=\"1200\" height=\"900\" fill=\"#f4f0e7\"/><rect x=\"48\" y=\"48\" width=\"1104\" height=\"804\" fill=\"none\" stroke=\"#758174\" stroke-width=\"2\"/><text x=\"92\" y=\"128\" fill=\"#a63d08\" font-family=\"system-ui\" font-size=\"28\" font-weight=\"600\">A postcard for the guestbook</text><text x=\"92\" y=\"250\" fill=\"#20241e\" font-family=\"system-ui\" font-size=\"40\">Hello from a passing visitor.</text><text x=\"92\" y=\"790\" fill=\"#20241e\" font-family=\"system-ui\" font-size=\"28\">From Fictional visitor</text></svg><h3>Hello from a passing visitor.</h3></a><p>Fictional visitor</p></article>",
      "css": ".ds-card{min-width:0;padding-bottom:20px;border-bottom:1px solid var(--border,#444952);color:var(--fg,#f2f3f5)}.ds-card a{color:inherit;text-decoration:none}.ds-card a:hover h3{text-decoration:underline}.ds-card a:focus-visible{display:block;outline:3px solid var(--accent,#ff9b55);outline-offset:4px}.ds-card .ds-postcard{display:block;width:100%;height:auto;aspect-ratio:4/3;border-radius:8px}.ds-card h3{font:600 20px/1.1 Space,system-ui;letter-spacing:-.025em;margin:16px 0 8px;overflow-wrap:anywhere}.ds-card p{font:16px/1.55 system-ui,sans-serif;overflow-wrap:anywhere}"
    },
    {
      "name": "Consent Checkbox",
      "kind": "input",
      "description": "Native required consent with wrapping label and visible focus.",
      "html": "<label class=\"ds-consent\"><input type=\"checkbox\" required> I wrote this and agree that the owner may publish my postcard and alias.</label>",
      "css": ".ds-consent{display:flex;align-items:flex-start;gap:12px;color:var(--fg,#f2f3f5);font:16px/1.55 system-ui,sans-serif}.ds-consent input{width:20px;height:20px;flex:none;margin-top:3px}.ds-consent input:focus-visible{outline:3px solid var(--accent,#ff9b55);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "The guestbook letterbox",
    "overview": "Keep the built editorial collection: Space headings, charcoal or warm-light surfaces, orange actions and the original magpie on a postcard-filled letterbox. Guest postcards extend that world with paper, ink and a visible preview. Here / there remains the guestbook identity; Linkarooie names the related collection destination. Owner titles, introductions, layouts and theme settings remain authoritative.",
    "keyCharacteristics": [
      "Original self-hosted illustration, explicitly separate from submitted contributions.",
      "Flat collection sections, native controls and readable contribution text.",
      "A paper postcard preview within the existing interface, in either theme."
    ],
    "rules": [
      {
        "name": "The Content Wrap Rule",
        "body": "User headings, captions, aliases, paragraphs and the owner brand can wrap anywhere. Preserve `min-width: 0` on constrained content. The detail header displays the owner brand, while the caption stays in the page heading and metadata.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do preserve both themes, original artwork/provenance and owner configuration.",
      "Do keep caption/alias available outside the postcard image and wrap unbroken input.",
      "Do distinguish pending review, public approval, closed/paused submissions and revocation in visible copy."
    ],
    "donts": [
      "Don't turn the guest code into an owner sign-in, imply automatic publication or expose unpublished contributions.",
      "Don't rebrand this guestbook, replace existing assets, or claim production/device/screen-reader acceptance from local captures."
    ]
  }
}
